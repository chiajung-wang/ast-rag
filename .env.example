# OpenRouter is the only provider. One key covers chat and embeddings.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Embedding model, used at index time and for every query.
#
# WARNING: changing this invalidates the index. Embeddings from two different
# models do not share a vector space, so a query embedded by one cannot be
# compared against an index built by the other. The model is recorded in the
# .db at index time and queries fail loudly on a mismatch — re-run `make index`
# after changing it.
EMBED_MODEL=openai/text-embedding-3-small

# Agent and judge models. OpenRouter slugs, note the dots: 4.5 not 4-5.
AGENT_MODEL=anthropic/claude-haiku-4.5
JUDGE_MODEL=anthropic/claude-sonnet-4.6
